rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    // users/{email} — doc ID is the account's lowercased, trimmed email.
    match /users/{userId} {
      allow read: if isInstaller(db) || isOwnProfile(userId);
      allow create: if isNewUnassignedProfile(userId);
      allow update: if isInstaller(db) || isOwnProfileUpdate(userId);
    }

    // installations/{uid} — doc ID is the homeowner's own Firebase Auth UID.
    match /installations/{installationId} {
      allow read: if isInstaller(db) || isAssignedHomeowner(installationId, db);
      allow create, update: if isInstaller(db);

      match /settings/mqtt {
        allow read: if isInstaller(db) || isAssignedHomeowner(installationId, db);
        allow write: if isInstaller(db);
      }

      // presence/{presenceUid} — a Firebase Auth UID, NOT an email. A
      // different identity space from users/{email} above.
      match /presence/{presenceUid} {
        allow read: if isInstaller(db) ||
          (isOwnUid(presenceUid) && isAssignedHomeowner(installationId, db));
        allow create, update: if isOwnUid(presenceUid) &&
          isAssignedHomeowner(installationId, db) &&
          request.resource.data.keys().hasOnly(['online', 'status', 'lastSeen']);
      }
    }

    match /telemetry/{installationId}/history/{series} {
      allow read, write: if isAssignedHomeowner(installationId, db);
    }
  }

  // ---- users/{email} identity ----

  function isOwnProfile(userId) {
    return request.auth != null &&
      request.auth.token.email != null &&
      request.auth.token.email.lower() == userId;
  }

  function isInstaller(database) {
    return request.auth != null &&
      request.auth.token.email != null &&
      exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
      get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'installer';
  }

  function isNewUnassignedProfile(userId) {
    return isOwnProfile(userId) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.email == request.auth.token.email &&
      request.resource.data.role == 'unassigned' &&
      !request.resource.data.keys().hasAny(['installationId']);
  }

  function isOwnProfileUpdate(userId) {
    return isOwnProfile(userId) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.email == request.auth.token.email &&
      request.resource.data.role == resource.data.role &&
      request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['uid', 'email', 'fullName', 'phoneNumber', 'updatedAt']);
  }

  // ---- installations/{uid} identity ----

  function isOwnUid(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  function isAssignedHomeowner(installationId, database) {
    return isOwnUid(installationId) &&
      request.auth.token.email != null &&
      exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
      get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'homeowner';
  }
}
